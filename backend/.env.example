PORT=3000
# La API usa app_user (permisos limitados). La cuenta admin solo la usan seed y retención.
DATABASE_URL=postgres://app_user:cambia-esta-clave-app@localhost:5432/consultas
DATABASE_ADMIN_URL=postgres://admin_consultas:cambia-esta-clave-admin@localhost:5432/consultas

# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DATA_KEY=
HMAC_KEY=
INSURER_SECRET=
PAYMENT_SECRET=

INSURER_URL=http://localhost:4001
PAYMENT_URL=http://localhost:4002
FRONTEND_ORIGIN=http://localhost:4200
COOKIE_SECURE=false
